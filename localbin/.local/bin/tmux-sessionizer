#!/usr/bin/env bash

create_session_layout() {
	local session_name=$1
	local session_path=$2

	tmux new-session -d -s "$session_name" -c "$session_path" -n "Editor" "/bin/zsh -lc 'nvim; exec /bin/zsh -l'"
	tmux new-window -t "$session_name:" -c "$session_path" -n "Server"
	tmux new-window -t "$session_name:" -c "$session_path" -n "AI" "/bin/zsh -lc 'opencode; exec /bin/zsh -l'"
	tmux new-window -t "$session_name:" -c "$session_path" -n "Version-Control" "/bin/zsh -lc 'jjui; exec /bin/zsh -l'"
	tmux new-window -t "$session_name:" -c "$session_path" -n "Terminal"
	tmux select-window -t "$session_name:Editor"
}

if [[ $# -eq 1 ]]; then
	selected=$1
else
	selected=$(find ~/git ~/work ~/personal ~/ ~/.config ~/.local/bin/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) | fzf)
fi

if [[ -z $selected ]]; then
	exit 0
fi

selected_name=$(basename "$selected" | tr . _)

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
	create_session_layout "$selected_name" "$selected"
fi

if [[ -n $TMUX ]]; then
	tmux switch-client -t "$selected_name"
else
	tmux attach-session -t "$selected_name"
fi
